{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "code",
          "match": "*",
          "claims": {
            "sub": "gitsync-local-admin",
            "email": "admin@example.com",
            "email_verified": true,
            "name": "Git Clone Manager Local Admin",
            "preferred_username": "admin"
          }
        }
      ]
    }
  ]
}
